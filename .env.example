# ForgeAI - Configuration
# Supported providers: "ollama" (local open models like llama3.2/mistral), "gemini", "groq", "openai", "mock" (offline fallback)

LLM_PROVIDER=gemini
# For Gemini API:
GEMINI_API_KEY=
# For Groq / OpenAI / Ollama:
GROQ_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Embedding provider: "local" (TF-IDF / Bag of Words / Cosine similarity) or "chroma" / "sentence-transformers"
EMBEDDING_PROVIDER=local

